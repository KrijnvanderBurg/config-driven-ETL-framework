{
  "title": "Samara Dashboard",
  "uid": "samara",
  "tags": ["samara"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Samara Application Logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"samara\"} | json | severity_text=~\"$log_level\"",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "log_level",
        "label": "Log Level",
        "type": "custom",
        "current": {
          "selected": false,
          "text": "INFO",
          "value": "INFO|WARNING|ERROR|CRITICAL"
        },
        "options": [
          {
            "selected": false,
            "text": "DEBUG",
            "value": "DEBUG|INFO|WARNING|ERROR|CRITICAL"
          },
          {
            "selected": true,
            "text": "INFO",
            "value": "INFO|WARNING|ERROR|CRITICAL"
          },
          {
            "selected": false,
            "text": "WARNING",
            "value": "WARNING|ERROR|CRITICAL"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "ERROR|CRITICAL"
          },
          {
            "selected": false,
            "text": "CRITICAL",
            "value": "CRITICAL"
          }
        ],
        "query": "DEBUG : DEBUG|INFO|WARNING|ERROR|CRITICAL, INFO : INFO|WARNING|ERROR|CRITICAL, WARNING : WARNING|ERROR|CRITICAL, ERROR : ERROR|CRITICAL, CRITICAL : CRITICAL",
        "hide": 0
      }
    ]
  }
}